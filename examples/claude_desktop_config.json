{
  "_comment": "預設用瀏覽器登入：只需填 UOF_BASE_URL，綁好後在對話中呼叫 uof_custom_login，於瀏覽器完成登入即可。身份就是實際登入的那個人；要換人就 uof_custom_logout 後重新登入。",
  "mcpServers": {
    "uof": {
      "command": "uv",
      "args": ["--directory", "/absolute/path/to/mcp-uof", "run", "mcp-uof"],
      "env": {
        "UOF_BASE_URL": "https://your-uof-domain.com/VirtualPath"
      }
    },
    "uof-unattended": {
      "_comment": "帳密自動登入備援：僅在無人值守（CI、自動化）或需要同時具備兩種身份時使用。兩個變數都填才會生效；請以安全方式提供密碼，不要明文入版控。",
      "command": "uv",
      "args": ["--directory", "/absolute/path/to/mcp-uof", "run", "mcp-uof"],
      "env": {
        "UOF_BASE_URL": "https://your-uof-domain.com/VirtualPath",
        "UOF_ACCOUNT": "service_account",
        "UOF_PASSWORD": "service_password"
      }
    }
  }
}
