# ──────────────────────────────────────────────
# UOF MCP Server — 環境變數範本
# 複製本檔案為 .env 並填入實際值
# 詳細說明見 docs/configuration.md
# ──────────────────────────────────────────────

# 所有工具使用 httpx + lxml 操作 UOF 網頁端點，不需要瀏覽器 runtime。

# UOF 站台基礎 URL（必填）
# 格式：https://your-uof-domain.com/VirtualPath（不含尾斜線）
# 範例：https://your-uof-host.example.com/UOF
UOF_BASE_URL=https://your-uof-domain.com

# ──────────────────────────────────────────────
# 登入方式：預設是「瀏覽器登入」——不需要在這裡填帳密。
# 直接呼叫 uof_custom_login 工具，會在使用者的預設瀏覽器開啟真實的 UOF 登入頁，
# 登入完成後 session 自動交回 MCP 並存到 ~/.uof（0600），重啟免重登。
#
# 下面兩個是「帳密自動登入」備援，適用於 CI、無人值守或跑 tests/mounted 的情境。
# 兩個都填才會生效；填了就會在需要時自動登入，不會開瀏覽器。
# ──────────────────────────────────────────────
UOF_ACCOUNT=
UOF_PASSWORD=

# SSL 憑證驗證（true = 嚴格驗證；只有本機或自簽憑證測試環境才建議設 false）
UOF_SSL_VERIFY=true

# ── 瀏覽器登入的可調參數（皆選填）──────────────
# uof_custom_login 同步等待使用者完成登入的秒數（預設 45；太長會撞到 MCP client 的 tool timeout）
UOF_LOGIN_WAIT_SECONDS=45
# 本機登入頁在背景保留的秒數（預設 600）
UOF_LOGIN_TIMEOUT_SECONDS=600
# session 存放目錄（預設 ~/.uof，支援 ~ 展開）。內容等同登入態，請放在只有你能讀的位置。
# UOF_SESSION_DIR=~/.uof
# 同一台機器、同一站台若有多個 server entry 代表不同人，**每個都要設不同值**，
# 否則啟動時無法判斷自己是誰（會拒絕沿用任何存檔，要求重新登入）。
# UOF_SESSION_NAMESPACE=
# 設為 false 則 session 只留在記憶體，不寫入磁碟（每次重啟都要重新登入）
UOF_SESSION_PERSIST=true
# 設任意值則把登入代理的逐筆請求印到 stderr（登入頁破版時除錯用）
# UOF_LOGIN_DEBUG=1

# mounted 真實層只使用上方 UOF_BASE_URL / UOF_ACCOUNT / UOF_PASSWORD，
# 執行單一身份的認證與唯讀查詢，不建立或異動表單。
